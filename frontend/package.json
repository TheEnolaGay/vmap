    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.25.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^25.0.1",
    "markdownlint-cli2": "^0.17.2",
    "prettier": "^3.5.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.30.1",
